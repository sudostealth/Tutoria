# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Secret Slug & Email Verification
# Access the admin panel by visiting /x-admin-control (or your custom slug)
VITE_ADMIN_SLUG=x-admin-control
ADMIN_SECRET_SLUG=x-admin-control

# Authorized Admin Email (Must match Supabase user email)
VITE_ADMIN_EMAIL=admin@tutoria.bd
ADMIN_EMAIL=admin@tutoria.bd
ADMIN_PASSWORD=admin123
